.DS_Store

# Python bytecode from scripts/pgso and local pytest/unittest
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# LLVM/PGSO profile dumps (default.profraw appears in the repo root when
# a profiled binary runs without LLVM_PROFILE_FILE)
*.profraw
*.profdata

# Scratch files (local only)
tmp/
.fx/

# Dependencies
node_modules/
bun.lock
!tests/e2e/bun.lock
!tests/evals/bun.lock
.next/

# Zig build output and fetched packages
.zig-cache/
zig-cache/
zig-out/
zig-pkg/
sdk/dist/

# Workspace-local runtime state
/skills/

# Local environment files
.env
.env.*
*.log

# Benchmark results (regenerated by CI)
benchmarks/results/*.json
benchmarks/baseline.json

# Local agent/editor/tooling directories from this workspace
.adal/
.agents/
.augment/
.bob/
